# ── QRix production environment template ────────────────────────────────
# Copy to .env (Docker) or paste into your host's env settings (Vercel).
# Every subsystem falls back to a safe mock until its keys exist.

# Core
AUTH_SECRET=change-me-64-random-chars
NEXT_PUBLIC_SITE_URL=https://qrix.uz
ADMIN_EMAILS=musarasulzada@gmail.com
LOG_LEVEL=info
CRON_SECRET=change-me

# Database (PostgreSQL — enables Prisma driver; use a pooled URL)
DATABASE_URL=postgres://user:pass@host:5432/qrix?connection_limit=10

# Cache / rate-limit / queue coordination (pick ONE)
REDIS_URL=redis://:password@host:6379
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx

# Object storage (s3 covers AWS S3 / Cloudflare R2 / Backblaze B2 / MinIO)
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_BUCKET=qrix-uploads
STORAGE_TEMP_TTL=60

# Auth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase (existing auth/data integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
NEXT_PUBLIC_BILLING_ENABLED=1
BILLING_TRIAL_DAYS=14

# Credits (engine meters always; set 1 to enforce deduction)
CREDITS_ENFORCED=0
ENTERPRISE_CREDITS=50000

# Email (console | resend | mailgun | smtp)
EMAIL_DRIVER=resend
EMAIL_FROM=QRix <no-reply@qrix.app>
RESEND_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_API_KEY=
# EMAIL_SERVER=smtps://user:pass@smtp.host:465

# AI Provider Manager (any key goes live instantly; free providers first)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
HUGGINGFACE_API_KEY=
# free tiers (cheahjs/free-llm-api-resources — Mission 55)
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=
GITHUB_MODELS_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_API_KEY=
FAL_API_KEY=
STABILITY_API_KEY=
# MuAPI — 200+ image/video models (engine behind Open-Generative-AI)
MUAPI_API_KEY=
# MUAPI_IMAGE_MODEL=flux-schnell-image
# CUSTOM_AI_URL=
# CUSTOM_AI_KEY=

# Video encoder worker (optional)
VIDEO_ENCODER_URL=

# Ads / analytics
NEXT_PUBLIC_ADSENSE_CLIENT=

# Telegram Admin Bot (owner-only; all four required)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OWNER_ID=
TELEGRAM_SECRET_TOKEN=
