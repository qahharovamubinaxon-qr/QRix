# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

public/imgly/

# 63MB GeoLite2 city DB — local dev fallback only. Production uses Vercel's
# x-vercel-ip-country/city headers (see lib/geoip.ts), so it must NOT ship in
# the serverless bundle or bloat clones.
geoip/*.mmdb

# graphify local knowledge-graph output (dev tool, not site code)
/graphify-out/

# growth continuous-loop lock (per-machine, never committed)
growth/.lock

# raw lighthouse runs kept while a CWV mission is open (per-machine, large)
/.psi/

# service-account keys must never land in the repo (they belong in ~/.qrix/)
*service-account*.json
gsc*.json

# listing screenshots produced by scripts/shoot-listing.mjs (regenerate, never commit)
scripts/.shots/

# generated SEO crawl output (npm run aeo:audit --json)
.seo-crawl.json
